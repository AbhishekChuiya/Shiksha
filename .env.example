# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=shiksha.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shiksha.example.com
DATABASE_URL=postgres://shiksha:password@127.0.0.1:5432/shiksha
DJANGO_MEDIA_ROOT=/srv/shiksha/media
# Set once HTTPS is confirmed working end-to-end (e.g. 31536000)
DJANGO_HSTS_SECONDS=0

# --- Sign-up / SSO (all optional for local use) ---
ALLOWED_EMAIL_DOMAINS=vishakha.com
DEFAULT_NEW_USER_PLANT_CODES=
# Microsoft Entra ID — values come from IT's app registration. SSO button appears only when all 3 are set.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/accounts/sso/callback/
# --- Outgoing email (reset / verification links). Without EMAIL_HOST, links print in the terminal. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Project Shiksha <noreply@vishakha.com>
