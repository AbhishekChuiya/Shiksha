# /etc/systemd/system/shiksha.service
[Unit]
Description=Project Shiksha (gunicorn)
After=network.target postgresql.service

[Service]
User=shiksha
Group=www-data
WorkingDirectory=/srv/shiksha/app
EnvironmentFile=/srv/shiksha/app/.env
ExecStart=/srv/shiksha/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/shiksha/gunicorn.sock --workers 3 --timeout 60 \
    --access-logfile - --error-logfile -
RuntimeDirectory=shiksha
Restart=always

[Install]
WantedBy=multi-user.target
